# Copy this to .env and fill in your values
# All are optional for local development (app runs with in-memory storage + disabled features)

# ============ DATABASE ============
# PostgreSQL connection string (leave empty to use in-memory storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/ringside

# ============ AUTH ============
# JWT secret for signing auth tokens (auto-generated on Render via render.yaml)
# JWT_SECRET=your-secure-random-string-here

# ============ SERVER ============
# Server port (Render sets this automatically)
# PORT=5000

# ============ PUSH NOTIFICATIONS ============
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:tom@mccannmd.com

# ============ STRIPE BILLING ============
# From https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Frontend (prefix with VITE_ so Vite exposes it to the client)
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
